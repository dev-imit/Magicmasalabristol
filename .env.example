# magicmasala-frontend — Create React App SPA
#
# Copy to .env for local development. NEVER commit a real .env.
# (This repo previously had .env, .env.staging and backend/.env all TRACKED.)
#
# ONE variable, and it is BUILD-TIME. react-scripts inlines REACT_APP_* into the
# JS bundle during `npm run build`, so the value is frozen into the artefact and
# is NOT read at runtime. In Dokploy mark it as a BUILD-time variable; setting it
# as runtime env does nothing.
#
# Consequence: changing it requires a REBUILD, not a restart.

# ── API origin ───────────────────────────────────────────────────────────────
# Used for /api/* calls and for /uploads/* image URLs.
#
# Same origin as the site: the backend is attached to the SAME domain under the
# path /api, so a bare origin is correct and no CORS setup is needed.
#
# CAUTION: five of the six consumers read
#     process.env.REACT_APP_API_URL || 'http://localhost:3001'
# (src/api.js, components/Gallery.js, Offers.js, AdminGallery.js, AdminOffers.js,
# Dashboard.js). Unset, the site builds and loads normally and then every image,
# offer and admin action fails in the VISITOR's own browser, because localhost is
# their machine. Nothing appears in the server logs. Always set it explicitly.
REACT_APP_API_URL=https://magicmasalabristol.com

# ── Build behaviour ──────────────────────────────────────────────────────────
# [OPTIONAL] Only needed if the app is ever served from a sub-path.
PUBLIC_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Notes (not env vars)
#
# GENERATE_SOURCEMAP=false and CI=false are pinned in the Dockerfile, not here —
# they are build behaviour, not configuration.
#
# The shared uploads directory is a read-only MOUNT, not a variable:
#   /var/www/magic-masala-data/uploads  ->  /usr/share/nginx/uploads
# The backend writes it; this container serves it at /uploads/.
#
# nginx.frontend.conf must be committed at the REPO ROOT — the Dockerfile COPYs
# it, and a build fails without it.
