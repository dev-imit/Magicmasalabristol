# magicmasala-backend — Express + better-sqlite3
#
# Copy to backend/.env and fill in. NEVER commit .env.
#
# Legend:  [BOOT-FATAL] require('./db') throws before any validation if unset

# ── Runtime ──────────────────────────────────────────────────────────────────
# NOTE the old deployment used 3001, which sndp-backend had already bound — which
# is why magicmasalabristol.com/api/ has been reaching the SNDP app. In Dokploy
# this app listens on the container port 3000 and Traefik routes by path.
PORT=3000
NODE_ENV=production

# ── Auth ─────────────────────────────────────────────────────────────────────
# [BOOT-FATAL] [SECRET]
#
# Was read as `process.env.JWT_SECRET || 'magic-masala-jwt-secret-change-in-
# production'` in three places (middleware/auth.js, db.js, routes/auth.js), so an
# unset value meant every token was signed with a literal published in this repo.
# Now validated in one place and fatal when missing.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# ── Admin account ────────────────────────────────────────────────────────────
# [BOOT-FATAL] [SECRET]
#
# db.js requires BOTH at import time — `require('./db')` dies without them before
# reaching its own validation, so the container cannot start.
#
# The previous defaults ('admin@magicmasala.com' / 'Admin@123') are in this
# repo's git history. Rotate: do not reuse them.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Mount reminders (not env vars)
#
#   /app/data     ->  /var/www/magic-masala-data/db        SQLite
#   /app/uploads  ->  /var/www/magic-masala-data/uploads   119 MB
#
# /app/data must be the DIRECTORY, never the .db file alone. The database is
# 40 KB while its -wal is 29.5 MB, so nearly all the data lives in the WAL and it
# must travel with the .db. Checkpoint the WAL before migrating.
#
# The copy inside the app tree (backend/magic_masala.db) is a SYMLINK into that
# data directory, which is why the data directory is the canonical location.
#
# Without the /app/data mount, better-sqlite3 silently creates a NEW empty
# database and the app reports healthy with no data and no error.
#
# REPO BLOCKER: 1819 files of backend/node_modules are committed here, including
# better-sqlite3's compiled better_sqlite3.node built for NODE_MODULE_VERSION 115.
# A Nixpacks git deployment inherits that binary and crashes at boot on any other
# Node version. Untrack it. (The Dockerfile path is unaffected — .dockerignore
# excludes node_modules, so the image compiles its own.)
